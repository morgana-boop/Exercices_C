{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar arquivo C atual",
      "type": "shell",
      "command": "mkdir -p \"${workspaceFolder}/build/Debug\" && gcc -std=c17 -Wall -Wextra -Wpedantic -g3 -O0 \"${file}\" -o \"${workspaceFolder}/build/Debug/${fileBasenameNoExtension}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}